[Unit]
Description=Google Chrome for jev-browser (persistent display :99, CDP 127.0.0.1:9333)
After=jev-xvfb.service jev-wm.service jev-proxy.service network-online.target
Requires=jev-xvfb.service
Wants=jev-wm.service jev-proxy.service network-online.target

[Service]
# chrome.env carries JEV_PROXY (the residential relay) and optional JEV_NO_SANDBOX / JEV_UA.
EnvironmentFile=-%h/jev-browser/vps/chrome.env
ExecStart=%h/jev-browser/vps/chrome.sh
Restart=always
RestartSec=3
KillMode=control-group

[Install]
WantedBy=default.target
